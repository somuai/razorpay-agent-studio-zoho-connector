      "name": "get_sales_order"
    },
    {
      "description": "PRIMARY DECISION PRIMITIVE for Abandoned Cart Conversion agents (FR-5). Returns an advisory stock status using an explicit Zoho availability quantity for up to 20 SKUs or item IDs. Confirm with the merchant that this field matches channel sellability before acting. Returns 'in_stock', 'low_stock', 'out_of_stock', or 'unknown', with data freshness 'as_of' and 'cached'.",
      "input_schema": {
        "properties": {
          "bypass_cache": {
            "default": false,
            "title": "Bypass Cache",
            "type": "boolean"
