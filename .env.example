# ==============================================================================
# Zoho Inventory Connector Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH YOUR CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Zoho OAuth Credentials (from api-console.zoho.in or api-console.zoho.com)
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here

# Headless / Self-Client Refresh Token (optional for local loopback flow, required for headless CI)
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho Organization ID (from Zoho Inventory -> Settings -> Organization Profile)
ZOHO_ORG_ID=your_organization_id_here

# Zoho Data Center ('in' for India, 'com' for US, 'eu' for Europe)
ZOHO_DC=in

# OAuth Redirect URI for interactive loopback server
ZOHO_REDIRECT_URI=http://localhost:8080/callback

# Path to local persisted token file (mode 0600)
ZOHO_TOKEN_FILE=.zoho_token.json

# Upstream Base URLs (uncomment to point connector to local mock server)
# ZOHO_API_BASE_URL=http://localhost:8000/inventory/v1
# ZOHO_ACCOUNTS_BASE_URL=http://localhost:8000

# Rate Limiting & Concurrency Controls
RATE_LIMIT_PER_MINUTE=80
CONCURRENCY_LIMIT=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
ZOHO_DAILY_QUOTA_LIMIT=1000

# Cache TTL Configuration (seconds)
CACHE_TTL_ITEMS_SECONDS=300
CACHE_TTL_STOCK_SECONDS=60

# Domain Logic Thresholds
DEFAULT_LOW_STOCK_THRESHOLD=5

# Optional Stretch: Anthropic API Key for Claude Agent SDK Demo (examples/agent_demo.py)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
