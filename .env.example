# ==============================================================================
# Zoho Inventory Connector Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH YOUR CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Zoho OAuth Credentials (from api-console.zoho.in or api-console.zoho.com)
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here

# Headless / Self-Client refresh token (optional; make zoho-token stores it in ZOHO_TOKEN_FILE)
ZOHO_REFRESH_TOKEN=

# Zoho Organization ID (from Zoho Inventory -> Settings -> Organization Profile)
ZOHO_ORG_ID=your_organization_id_here

# Zoho Data Center ('in' for India, 'com' for US, 'eu' for Europe)
ZOHO_DC=in

# OAuth Redirect URI for interactive loopback server
ZOHO_REDIRECT_URI=http://localhost:8080/callback

# Path to local persisted token file (mode 0600)
ZOHO_TOKEN_FILE=.zoho_token.json

# PII-minimized tool audit stream; keep the file private and rotate per policy.
ZOHO_AUDIT_LOG_FILE=.zoho_audit.jsonl

# Upstream Base URLs (uncomment to point connector to local mock server)
# ZOHO_API_BASE_URL=http://localhost:8000/inventory/v1
# ZOHO_ACCOUNTS_BASE_URL=http://localhost:8000

# Rate Limiting & Concurrency Controls
RATE_LIMIT_PER_MINUTE=80
CONCURRENCY_LIMIT=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
ZOHO_DAILY_QUOTA_LIMIT=1000

# Cache TTL Configuration (seconds)
CACHE_TTL_ITEMS_SECONDS=300
CACHE_TTL_STOCK_SECONDS=60

# Domain Logic Thresholds
DEFAULT_LOW_STOCK_THRESHOLD=5

# Separate token credentials for scripts/seed_zoho.py only. Keep the seed token
# in its own file and revoke it after preparing a throwaway organization.
# Its refresh token needs these READ scopes for preflight/idempotency:
# ZohoInventory.items.READ,ZohoInventory.contacts.READ,
# ZohoInventory.salesorders.READ,ZohoInventory.packages.READ
# plus these CREATE scopes for the fictional records it writes:
# ZohoInventory.items.CREATE,ZohoInventory.contacts.CREATE,
# ZohoInventory.salesorders.CREATE,ZohoInventory.packages.CREATE,
# ZohoInventory.shipmentorders.CREATE
# ZOHO_SEED_CLIENT_ID=your_seed_client_id_here
# ZOHO_SEED_CLIENT_SECRET=your_seed_client_secret_here
# ZOHO_SEED_REFRESH_TOKEN=your_seed_refresh_token_here
# ZOHO_SEED_TOKEN_FILE=.zoho_seed_token.json
# ZOHO_SEED_STATE_FILE=.zoho_seed_state.json
# ZOHO_SEED_ORG_ID=throwaway_organization_id
# ZOHO_SEED_LOCATION_ID=throwaway_location_id
# ZOHO_SEED_API_DOMAIN=https://www.zohoapis.in

# Optional M11 only, after M1–M10 are green (examples/agent_demo.py)
# GEMINI_API_KEY=your_gemini_api_key_here
